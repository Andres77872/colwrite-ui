# ColWrite UI environment configuration
#
# Copy this file to `.env` for local overrides:
#   cp .env.example .env
#
# Vite reads these variables when the dev server or build starts. Values
# already present in the OS/process environment have the highest priority;
# `.env` supplies fallback values. Mode-specific files such as
# `.env.production` can override `.env` when the variable is not supplied by
# the OS. Restart Vite after changing an env file.
#
# Every VITE_* variable is embedded in the browser bundle at build time.
# Never put passwords, API keys, tokens, or other secrets in these values.

# ColWrite API that `npm run dev` and `npm run preview` proxy `/api` to. Read
# only by vite.config.ts, never bundled. Defaults to the shared development
# API. Use http://127.0.0.1:5002 for a backend running on this machine; only
# a loopback API offers the local Claude Code / Codex agent engines.
COLWRITE_API_URL=https://colwrite-api.novus.chat

# Browser-facing API base. `npm run dev` defaults to `/api`; `npm run build`
# defaults to the shared development API directly. Set this to `/api` before
# building to use the Vite preview proxy or a deployed same-origin `/api` proxy.
#
# For direct `/auth/refresh`, leave AUTH_COOKIE_PATH_PREFIX blank on the API.
# For `/api/auth/refresh`, set AUTH_COOKIE_PATH_PREFIX=/api unless the proxy
# rewrites the cookie from Path=/auth to Path=/api/auth, as Vite does.
# VITE_API_BASE=https://colwrite-api.novus.chat
