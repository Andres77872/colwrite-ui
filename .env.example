# ColWrite UI environment configuration
#
# Copy this file to `.env` for local overrides:
#   cp .env.example .env
#
# Vite reads these variables when the dev server or build starts. Values
# already present in the OS/process environment have the highest priority;
# `.env` supplies fallback values. Mode-specific files such as
# `.env.production` can override `.env` when the variable is not supplied by
# the OS. Restart Vite after changing an env file.
#
# Every VITE_* variable is embedded in the browser bundle at build time.
# Never put passwords, API keys, tokens, or other secrets in these values.

# ColWrite API that `npm run dev` and `npm run preview` proxy `/api` to. Read
# only by vite.config.ts, never bundled. Defaults to production. Use
# http://127.0.0.1:5002 for a backend running on this machine; only a loopback
# API offers the local Claude Code / Codex agent engines.
COLWRITE_API_URL=https://colwrite-api.novus.chat

# Path or URL the browser uses for API requests.
# Keep `/api` to use the Vite development proxy and a same-origin `/api` route
# in production. An absolute URL may be used when the API allows browser CORS.
# Keep it relative when other devices open the dev server over the local
# network: an absolute localhost URL would point them at themselves.
VITE_API_BASE=/api

# Base URL for the external arXiv search service.
VITE_ARZ_API=https://llm.arz.ai

# Base URL for the external ColPali search service.
VITE_COLPALI_BASE=https://llm.arz.ai
