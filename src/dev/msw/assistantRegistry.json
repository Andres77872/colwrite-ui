  "efforts": [
    {
      "id": "quick",
      "label": "Quick",
      "description": "A lookup, a small edit, any inline action.",
      "budget": {
        "model_calls": 12,
        "tool_calls": 20,
        "web_calls": 4,
        "scholarly_calls": 8,
        "workers": 0,
        "wall_clock_seconds": 300,
        "cost_limit": 1.0
      },
      "needs_plan": false,
      "cuts": [
        {
          "tool": "delegate",
          "reason": "A quick run starts no workers."
        }
      ]
    },
    {
      "id": "standard",
      "label": "Standard",
      "description": "A focused question, a section, a claim check.",
      "budget": {
        "model_calls": 40,
        "tool_calls": 60,
        "web_calls": 12,
        "scholarly_calls": 30,
        "workers": 3,
        "wall_clock_seconds": 1200,
        "cost_limit": 5.0
      },
      "needs_plan": false,
      "cuts": []
    },
    {
      "id": "deep",
      "label": "Deep",
      "description": "A literature review, a report, a full review. Starts from a plan you approve.",
      "budget": {
        "model_calls": 120,
        "tool_calls": 200,
        "web_calls": 40,
        "scholarly_calls": 100,
        "workers": 6,
        "wall_clock_seconds": 3600,
        "cost_limit": 20.0
      },
      "needs_plan": true,
      "cuts": []
    }
  ],
  "workers": [
    {
      "id": "web_researcher",
      "label": "Web researcher",
      "description": "Finds out what outside sources, papers and the web, say about one question. It never sees the page.",
      "tools": [
        "evidence_read",
        "paper_search",
        "paper_get",
        "paper_graph",
        "paper_passages",
        "web_search",
        "web_read",
