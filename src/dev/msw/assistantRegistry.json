  "skills": [
    {
      "id": "ai-use-disclosure",
      "label": "AI-use disclosure",
      "description": "Helps draft an AI-use disclosure from the page's actual AI-use record and the target venue's dated policy, preserving the author's responsibility and gaps in the record. Use for an AI-use statement or disclosure of assistance. Not for claiming no AI was used, inferring use outside ColWrite or promising that a statement guarantees venue compliance.",
      "version": "1",
      "profiles": [
        "chat",
        "inline"
      ],
      "needs": [],
      "guidelines": null,
      "read": null
    },
    {
      "id": "citing",
      "label": "Citing",
      "description": "Cites works in a ColWrite page the way the server checks them, by handle with cite_sources, each citation tied to the passage its claim rests on, and decides what to do with a work that is retracted, unverified, a preprint or not found. Use whenever you are about to add, move or replace a citation in the page, or the author asks to cite a source they named. Not for finding which sources support a sentence (use find-citations), and not for checking the references already on the page (use evidence-review).",
      "version": "1",
      "profiles": [
        "chat"
      ],
      "needs": [
        "citations"
      ],
      "guidelines": "ICMJE Recommendations (updated January 2026), IV.A.3.g; Crossref DOI display guidelines",
      "read": "2026-11-15"
    },
    {
      "id": "editor",
      "label": "Writing blocks",
      "description": "Writing blocks into a ColWrite page with doc_edit and doc_create, so the editor renders real lists, tables, charts, equations, diagrams and figures and no widget is lost in a rewrite. Use before writing, rewriting or restructuring blocks. Not for deciding what to write, and not needed for a wording fix inside a block, which replace_text makes.",
      "version": "1",
      "profiles": [
        "chat",
        "inline"
      ],
      "needs": [
        "page"
      ],
      "guidelines": null,
      "read": null
    },
    {
      "id": "evidence-review",
      "label": "Evidence review",
      "description": "Audits the claims and references of text the author already wrote, what each claim rests on, how strong that support is and the state of each reference, and reports the findings for the author to act on. Use when the author asks to fact-check, check the claims, the evidence or the references of a page or a passage, or whether a draft is ready to submit. Not for finding sources for sentences that have none (use find-citations), and not for writing a review of the literature (use literature-review).",
      "version": "2",
      "profiles": [
        "chat",
        "inline",
        "review"
      ],
      "needs": [
        "evidence"
      ],
      "guidelines": "ICMJE Recommendations (updated January 2026), IV.A.3.g, on citing original sources and preprints",
      "read": "2026-11-15"
    },
    {
      "id": "figures-and-images",
      "label": "Figures and images",
      "description": "Chooses how to show something visually in a ColWrite page, a chart, a table, a Mermaid diagram, a structured figure or an image, and writes its caption and alt text within what venues allow for AI-made images. Use when the author asks for a figure, a chart, a diagram, an illustration, a graphical abstract or an image, asks how to show a result, or asks for a caption or alt text. Not for the block syntax of a widget once chosen (the editor skill has it), and never for an image of results or data.",
      "version": "1",
      "profiles": [
        "chat"
      ],
      "needs": [
        "page"
      ],
      "guidelines": "ICMJE Recommendations (updated January 2026), IV.A.3.h–i; AI-image policies of Elsevier, Springer Nature, Science, Taylor & Francis, Wiley, PLOS, IEEE and ACS as listed in references/venue-rules.md",
      "read": "2026-11-15"
    },
    {
      "id": "find-citations",
      "label": "Find citations",
      "description": "Finds evidence for specific uncited claims in existing text, one claim at a time, and proposes only citations whose passages match the claim. Use when asked to source these sentences or find support for a stated claim. Not for general background reading or a literature review, and not for auditing the citations already present (evidence-review).",
      "version": "1",
      "profiles": [
        "chat",
        "inline"
      ],
      "needs": [
        "evidence"
      ],
      "guidelines": null,
      "read": null
    },
    {
      "id": "literature-review",
      "label": "Literature review",
      "description": "Plans and synthesizes a literature review or related-work section from identifiable sources, an evidence matrix and a source-bound outline. Use for comparing a body of research, mapping disagreements or writing related work. Not for checking an already-written claim (evidence-review), finding one citation (find-citations), or claiming a systematic search without a protocol (systematic-review).",
      "version": "1",
      "profiles": [
        "chat",
        "inline"
      ],
      "needs": [
        "evidence"
      ],
      "guidelines": null,
      "read": null
    },
